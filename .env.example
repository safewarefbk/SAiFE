# ──────────────────────────────────────────────────────────────────────────────
# SAiFE — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never baked into the Docker image.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL credentials (used by both the postgres container and the app).
# Change these to something strong before running in any shared/demo environment.
POSTGRES_USER=saife_user
POSTGRES_PASSWORD=saife_password

# Local development (docker compose):
DATABASE_URL="postgresql://saife_user:saife_password@localhost:5432/saife?schema=public"

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Option A – Multiple keys for rate-limit distribution (recommended for demos).
# Keys are used round-robin across requests.
# GEMINI_API_KEYS=key1,key2,key3

# Option B – Single key (legacy, still supported).
GEMINI_API_KEY=your-gemini-api-key-here

