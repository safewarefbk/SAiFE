# ──────────────────────────────────────────────────────────────────────────────
# SAiFE — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never baked into the Docker image.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local / Docker):
DATABASE_URL="file:/app/prisma/data/saife.db"

# PostgreSQL (production — uncomment and fill in when ready):
# DATABASE_URL="postgresql://user:password@host:5432/saife?schema=public"

# ── LLM API Keys ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

