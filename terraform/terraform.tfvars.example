project_id = "my-gcp-project-id"
region     = "europe-west8"
zone       = "europe-west8-b"

# ─── IP Allowlist ────────────────────────────────────────────────────────────
# Port 443 (HTTPS): only these IPs can reach the application.
# Port 80 is completely closed.
# Collect all participant IPs beforehand. /32 for a single host, /24 for a range.
allowed_cidr_blocks = [
  "203.0.113.0/24",      # Example: venue / institution network
  "198.51.100.50/32",    # Example: individual with static IP
  # Add one entry per participant IP or shared network range
]

# Port 22 (SSH): admin access only — YOUR IP only, never participant IPs.
admin_cidr_blocks = [
  # "your.ip.address/32"
]

# ─── VM Sizing ───────────────────────────────────────────────────────────────
machine_type = "e2-medium"       # 2 vCPU, 4 GB RAM — sufficient for 3-4 users
disk_size_gb = 15

# Boot disk OS image. Alternatives (uncomment to switch):
#   Ubuntu 22.04 LTS:  "projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts"
#   Debian 12:         "projects/debian-cloud/global/images/family/debian-12"
os_image = "projects/debian-cloud/global/images/family/debian-12"

# ─── Egress Control ──────────────────────────────────────────────────────────
# setup.sh sets this to true automatically during deploy, then back to false
# once everything is running. Do NOT change this manually.
enable_provisioning_egress = false


# ─── Instance Schedule (auto start/stop) ─────────────────────────────────────
# Set to true to auto-shutdown at night and restart in the morning.
enable_instance_schedule = true
schedule_start_cron      = "0 8 * * 1-5"    # 8:00 AM weekdays
schedule_stop_cron       = "0 19 * * 1-5"   # 8:00 PM weekdays
schedule_timezone         = "Europe/Rome"


# ─── Domain (optional) ──────────────────────────────────────────────────────
domain_name = ""   # Set to e.g. "saife.example.com" for auto-TLS via Let's Encrypt

# ─── Secrets are NOT here ────────────────────────────────────────────────────
# postgres_user, postgres_password, gemini_api_keys, ssh_username, ssh_public_key_path
# are all read from the project's .env file by setup.sh and passed to Terraform
# as TF_VAR_* environment variables. Edit .env — not this file.

