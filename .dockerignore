# Dependencies — reinstalled inside the image
node_modules

# Next.js build artefacts — rebuilt inside the image
.next
out
build

# Local database — mounted as a volume at runtime
prisma/dev.db
prisma/dev.db-shm
prisma/dev.db-wal

# Secrets — injected via environment variables at runtime, never baked in
.env
.env.*
!.env.example

# Dev / IDE noise
.git
.gitignore
.idea
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tsconfig.tsbuildinfo
next-env.d.ts
coverage
README.md
ARCHITECTURE.md

